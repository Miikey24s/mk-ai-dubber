# Virtual environments & package manager caches
.venv/
.uv-cache/
.uv-python/
.pytest_cache/
__pycache__/
*.pyc

# Heavy model weights and checkpoints (downloaded on demand or provisioned locally)
models/*
!models/.gitkeep

# Portable binaries in tools
tools/ffmpeg/
tools/llama/
tools/downloads/

# Media & audio/video files (keep repo lightweight, download/synthesize on demand)
*.mp4
*.wav
*.mkv
*.mov
*.webm
*.avi
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.jpg
*.jpeg
*.png

# Temporary logs & scratch files
*.log
*.tmp
work/artifacts/

# Execution work directory: ignore all generated job stems, outputs, and intermediate folders
work/*
!work/.gitkeep
!work/checkpoints/
!work/checkpoints/**
!work/benchmarks/
work/benchmarks/*
!work/benchmarks/fixtures.json
!work/benchmarks/*.json
!work/benchmarks/p14-synthetic-acceptance/
!work/benchmarks/p14-synthetic-acceptance/*.json
!work/benchmarks/p17-synthetic-missing-classes/
work/benchmarks/p17-synthetic-missing-classes/*
!work/benchmarks/p17-synthetic-missing-classes/generate.ps1
!work/benchmarks/p17-synthetic-missing-classes/*/
work/benchmarks/p17-synthetic-missing-classes/*/*
!work/benchmarks/p17-synthetic-missing-classes/*/*.json
